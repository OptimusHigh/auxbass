# Telegram Bot
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username  # Without @, for Telegram Login Widget

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tg_player
# For SQLite (development): sqlite+aiosqlite:///./tg_player.db

# API
API_HOST=0.0.0.0
API_PORT=8000
# ВАЖНО: API_URL и WEBAPP_URL должны указывать на ваш домен!
# Для aux.ganj4craft.ru:
# API_URL=https://aux.ganj4craft.ru
# WEBAPP_URL=https://aux.ganj4craft.ru
API_URL=https://your-domain.com

# Mini App (URL для Telegram WebAppInfo кнопок и CORS)
WEBAPP_URL=https://your-domain.com

# Security
SECRET_KEY=your-secret-key-generate-random-string
JWT_EXPIRE_DAYS=30  # How long browser auth tokens are valid

# last fm
LASTFM_API_KEY=your_lastfm_api_key_here

# Proxy & Network settings (ОБЯЗАТЕЛЬНО для РФ: доступ к Spotify, YouTube, SoundCloud, Last.fm)
# Поддерживаются HTTP, HTTPS, SOCKS5 (например "http://127.0.0.1:10809" или "socks5://127.0.0.1:10808" или "http://user:pass@host:port")
# Если не указан, TG Player автоматически обнаружит локальный работающий прокси (v2rayN, Xray, Clash, sing-box)
PROXY_URL=http://127.0.0.1:10809